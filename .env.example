# Skopiuj do .env i uzupełnij.

# Baza danych.
# Lokalnie (SQLite): plik w katalogu projektu.
DATABASE_URL="file:./dev.db"
# Produkcja (Postgres) — przykład:
# DATABASE_URL="postgresql://user:haslo@host:5432/baza?sslmode=require"

# Publiczny adres aplikacji (używany do budowy linku w kodzie QR).
# Lokalnie można zostawić puste — zostanie odczytany z nagłówków żądania.
# NEXT_PUBLIC_APP_URL="https://twoja-domena.pl"
